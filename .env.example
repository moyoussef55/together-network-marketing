# Copy to .env on the Namecheap server. Never commit real values.
NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL=https://YOUR-DOMAIN.example

# Existing Hatchable PostgreSQL database only; direct access must be confirmed.
# Do not point this at an imported copy for production cutover.
DATABASE_URL=
DB_SCHEMA=app_a8bd59e089a78f6d
DATABASE_SSL=true

# Persistent upload storage on Namecheap, outside public/.
STORAGE_DIR=./var/uploads
STORAGE_SIGNING_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# SMTP is required for password-reset email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Hatchable project secrets; set privately on the server, never in GitHub.
TOGETHER_GMAIL_WEBAPP_URL=
TOGETHER_GMAIL_SHARED_SECRET=
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# Required for Namecheap Cron Jobs to invoke the weekly BV handler.
CRON_SECRET=REPLACE_WITH_ANOTHER_LONG_RANDOM_SECRET
